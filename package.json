{
  "name": "warhammer-nameplates",
  "version": "0.1.0",
  "private": true,
  "description": "Generate 3D-printable nameplates for the rims of Warhammer miniature bases",
  "type": "module",
  "bin": {
    "nameplate": "src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "nameplate": "tsx src/cli.ts",
    "render": "tsx scripts/render-readme-images.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aledegano/warhammer-nameplates.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

{
  "name": "warhammer-nameplates",
  "version": "0.1.0",
  "private": true,
  "description": "Generate 3D-printable nameplates for the rims of Warhammer miniature bases",
  "type": "module",
  "bin": {
    "nameplate": "src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "nameplate": "tsx src/cli.ts",
    "render": "tsx scripts/render-readme-images.ts",
    "web": "vite",
    "web:build": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aledegano/warhammer-nameplates.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
